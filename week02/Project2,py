def reverse_word (word):
    delete_low_word = word.strip().lower().replace(" ", "")

    reverse_text = delete_low_word[::-1]

    return delete_low_word == reverse_text

def main():
    words = ["토마토", "bye", "구로 구", "eye"]

    print("단어 리스트 : " + " / ".join(words))
    
    for word in words:
        if reverse_word(word):
            print(f"{word} : 회문")

        else:
            print(f"{word} : 회문 아님")

if __name__ == "__main__":
    main()